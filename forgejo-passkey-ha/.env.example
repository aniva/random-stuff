# Domain names (internal VPN DNS)
APP_NAME="Home Git"
GIT_DOMAIN=git.home.example.com
AUTH_DOMAIN=auth.home.example.com

# AWS Route 53 credentials for Caddy ACME DNS-01 TLS
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1

# Host storage path (bind-mounted ONLY into containers for strict host isolation)
DATA_DIR=./data

# Interface / Ports exposed on VPN / isolated LAN interface
BIND_IP=0.0.0.0
HTTPS_PORT=443
SSH_PORT=2222

# Container UID/GID (match unprivileged host user for rootless isolation)
PUID=1000
PGID=1000

# PostgreSQL
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Pocket ID (Passkey-only OIDC)
POCKET_ID_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_HEX

# Push Policy (pre-receive hook)
MAX_FILE_SIZE_MB=25

# Standby Replication (used by scripts/sync-to-standby.sh on Primary)
STANDBY_SSH_TARGET=standby-sync@10.x.x.x
STANDBY_REMOTE_DIR=/srv/forgejo-passkey-ha/data
STANDBY_SSH_KEY=./secrets/standby_sync_ed25519

# Point-in-Time Restic Backups (used by scripts/backup-snapshot.sh)
RESTIC_REPO_LOCAL=/mnt/second-drive/backups/mygit-restic
RESTIC_REPO_REMOTE=sftp:backup@backup-host:/srv/backups/mygit-restic
RESTIC_PASSWORD_FILE=./.restic-pass

# Optional Telegram Onboarding Notifications (used by access-request service)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
